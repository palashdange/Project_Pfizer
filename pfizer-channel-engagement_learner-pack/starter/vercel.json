{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "rewrites": [
    {
      "source": "/demos",
      "destination": "/demos.html"
    }
  ],
  "functions": {
    "app.py": {
      "excludeFiles": "{tests/**,.venv/**,.pytest_cache/**,**/__pycache__/**,**/*.pyc,AGENTS.md,README.md,.env,.env.*,**/.env,**/.env.*}"
    }
  }
}
